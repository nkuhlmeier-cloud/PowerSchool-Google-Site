<a class="slide" href="https://drive.google.com/file/d/1gIUeKf2Iz1kaAdPIM40KCmVj9u_T4xMa/view" target="_blank" rel="noopener"><span class="c1"></span><span class="c2"></span><span class="c3"></span><div class="bar"></div><div class="t">TAKING ATTENDANCE<br>AT SUMMIT</div><span class="pill">TAS + SUPPORT STAFF</span></a>
</div></div>
</div>
<script>document.querySelectorAll('details').forEach(function(d){d.addEventListener('toggle',function(){if(d.open)document.querySelectorAll('details').forEach(function(o){if(o!==d)o.open=false})})})</script>
<style id="rsp">
body.cards{padding:0!important;height:100vh;overflow:hidden;background:#eef4f8}
body.cards>.wrap{display:none}
body:not(.cards) .deck{display:none}
.deck{height:100vh;display:flex;flex-direction:column;padding:7px 7px 5px}
.deck .card{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;background:#fff;border:1.5px solid var(--acc,#F5B82E);border-radius:14px;box-shadow:0 1px 3px rgba(16,42,84,.10);overflow:hidden}
.deck .ch{display:flex;align-items:center;gap:9px;padding:8px 11px 3px}
.deck .cnum{flex:0 0 27px;height:27px;border-radius:50%;background:var(--acc,#F5B82E);color:#1F3864;font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center}
.deck .ck{font-size:10.5px;font-weight:800;letter-spacing:2px;color:#6b7c92}
.deck h3.ct{font-size:15.5px;font-weight:800;color:#12305e;line-height:1.25;padding:0 11px 5px;margin:0}
.deck .cb{flex:1 1 auto;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:0 11px 9px;font-size:13.5px;line-height:1.42;color:#51637a}
.deck .cb b{color:#12305e}
.deck .cb .shot,.deck .cb .browser{display:none}
.deck .cb .path{font-size:12.5px;padding:1px 6px}
.deck .cb .pic{display:inline-block;margin-top:5px;font-size:11.5px}
.deck .cb .codes{gap:6px;margin:6px 0 2px}
.deck .cb .code{min-width:0;padding:5px 8px;font-size:12px}
.deck .cb .code b{font-size:13px}
.deck .cb .gk{display:flex;gap:8px;padding:4px 0;font-size:13px;color:#5d5233;line-height:1.38;align-items:flex-start}
.deck .cb .gk .ic{flex:0 0 19px;font-size:13px}
.deck .cb .chip{display:inline-block;font-size:10px;padding:3px 8px;letter-spacing:.6px;margin:0 4px 5px 0}
.deck .cb p{margin:4px 0 0}
.deck .cb a.lk{display:block;background:#E4EEF8;border:1px solid #cddcec;border-radius:9px;padding:9px 11px;margin:5px 0;color:#1F3864;font-weight:800;text-decoration:none;font-size:13px}
.deck .nav{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6px 1px 0}
.deck .nav button{border:0;border-radius:999px;padding:8px 14px;font-weight:800;font-size:13px;background:#1F3864;color:#fff;cursor:pointer;font-family:inherit;line-height:1.2}
.deck .nav button[disabled]{opacity:.28}
.deck .dots{display:flex;gap:4px;flex-wrap:wrap;justify-content:center;max-width:40%}
.deck .dots i{width:6px;height:6px;border-radius:50%;background:#c3d1e0;display:block}
.deck .dots i.on{background:#1F3864}
</style>
<script>
(function(){
var BASE=974,BP=700,idx=0,deck=null,cards=[];
function q(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s));}
function collect(){
 var steps=q('details.step');cards=[];
 var lab=((document.querySelector('.label')||{}).textContent||'').replace(/\s+/g,' ').trim();
 var faq=/QUESTION/i.test(lab),opt=!faq&&/WAYS|OPTION|HELP/i.test(lab);
 var kind=faq?'QUESTION':(opt?'OPTION':'STEP');
 var head=faq?'COMMON QUESTIONS':(opt?'WAYS TO GET HELP':'HOW TO DO IT');
 var chips=q('.chips .chip').map(function(c){return '<span class="chip">'+c.innerHTML+'</span>';}).join('');
 var pics=q('.pic').length>0;
 cards.push({k:head,num:'&#9654;',title:steps.length+' '+(faq?'quick answers':(opt?'ways to get help':'short steps')),body:'<div>'+chips+'</div><p>Tap <b>Next</b> to go one at a time. Swiping works too.'+(pics?' The pictures are right below this box.':'')+'</p>'});
 steps.forEach(function(d,i){var h=d.querySelector('summary h3'),b=d.querySelector('.body');cards.push({k:kind+' '+(i+1)+' OF '+steps.length,num:String(i+1),title:h?h.innerHTML:'',body:b?b.innerHTML:''});});
 var co=document.querySelector('.callout');
 if(co){var gks=q('.gk',co);gks.forEach(function(g,i){var ic=g.querySelector('.ic');var tx=g.querySelector('span:not(.ic)');cards.push({k:'GOOD TO KNOW '+(i+1)+' OF '+gks.length,num:ic?ic.innerHTML:'&#10003;',title:'Worth knowing',body:'<div class="gk"><span>'+(tx?tx.innerHTML:g.innerHTML)+'</span></div>'});});}
 var st=document.querySelector('.strip');
 if(st){var ls=q('a.slide',st).map(function(a){var t=a.querySelector('.t');return '<a class="lk" href="'+a.getAttribute('href')+'" target="_blank" rel="noopener">'+(t?t.innerHTML:a.textContent)+' &rarr;</a>';}).join('');if(ls){cards.push({k:'FROM THE TRAINING',num:'&#9654;',title:'Open the training slides',body:ls});}}
}
function render(){
 var c=cards[idx];
 deck.innerHTML='<div class="card"><div class="ch"><span class="cnum">'+c.num+'</span><span class="ck">'+c.k+'</span></div><h3 class="ct">'+c.title+'</h3><div class="cb">'+c.body+'</div></div><div class="nav"><button type="button" id="bk"'+(idx===0?' disabled':'')+'>&larr; Back</button><div class="dots">'+cards.map(function(_,i){return '<i'+(i===idx?' class="on"':'')+'></i>';}).join('')+'</div><button type="button" id="nx"'+(idx===cards.length-1?' disabled':'')+'>Next &rarr;</button></div>';
 deck.querySelector('#bk').onclick=function(){if(idx>0){idx--;render();}};
 deck.querySelector('#nx').onclick=function(){if(idx<cards.length-1){idx++;render();}};
}
function apply(){
 var w=window.innerWidth;
 if(w<BP){
  if(!deck){
   var n=document.querySelector('.num');
   if(n){try{document.documentElement.style.setProperty('--acc',getComputedStyle(n).backgroundColor);}catch(e){}}
   collect();deck=document.createElement('div');deck.className='deck';document.body.appendChild(deck);
   var sx=0;deck.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});
   deck.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-sx;if(dx<-50&&idx<cards.length-1){idx++;render();}else if(dx>50&&idx>0){idx--;render();}},{passive:true});
   render();
  }
  document.body.classList.add('cards');document.body.style.zoom='';
 }else{
  document.body.classList.remove('cards');document.body.style.zoom=String(w/BASE);
 }
}
apply();window.addEventListener('resize',apply);
})();
</script>
</body></html>
